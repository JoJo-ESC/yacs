# Copy this file to secrets.yaml and fill in your values.
# secrets.yaml is gitignored — never commit it.
# Every value here can also be set as an environment variable, which wins over
# this file. Production sets them all that way (see docker-compose.prod.yml and
# .env.production.example) and needs no secrets.yaml.

# Session signing key — use a long random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY: "change_me_in_production"

# Session cookie settings
SESSION_SAME_SITE: "lax"
SESSION_HTTPS_ONLY: false
SESSION_MAX_AGE_SECONDS: 43200

# Database credentials (override config.yaml defaults)
DB_USER: "yacs"
DB_PASS: "yacs"

# Redis connection URL
# Docker Compose: redis://redis:6379/0
# Local dev (no Docker): redis://localhost:6379/0
REDIS_URL: "redis://redis:6379/0"
