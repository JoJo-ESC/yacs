# Settings for docker-compose.prod.yml. On the server:
#   cp .env.production.example .env
# then fill in the values below. .env is gitignored: never commit it.

# Domain the site is served on. Its DNS A record must point at this server's
# IP before starting, so Caddy can get the HTTPS certificate.
DOMAIN=yacs.example.com

# Signs login session cookies. Anyone with this can forge sessions, including
# admin ones. Generate a fresh one for production:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Postgres password (used by both the database and the backend). Generate:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
DB_PASS=

# PostHog analytics (optional; leave POSTHOG_KEY empty to turn analytics off).
# Project key from PostHog: Project settings -> Project API key (starts phc_).
# Changing it requires a rebuild: docker compose -f docker-compose.prod.yml up -d --build
POSTHOG_KEY=
# Defaults are for a US PostHog project. For an EU project use:
# POSTHOG_HOST=eu.i.posthog.com
# POSTHOG_ASSETS_HOST=eu-assets.i.posthog.com
# POSTHOG_UI_HOST=https://eu.posthog.com

# Optional; these defaults match development.
# DB_NAME=yacsdb
# DB_USER=yacs
